# Copy to .dev.vars (gitignored) and fill in real values locally.
# Production: set each with `npx wrangler secret put NAME` — never commit real values.
JWT_SECRET=your_long_random_string_here
STRIPE_SECRET_KEY=your_test_secret_key_here
STRIPE_WEBHOOK_SECRET=your_webhook_secret_here
STRIPE_CONNECT_WEBHOOK_SECRET=your_connect_webhook_secret_here
APP_URL=http://localhost:3000
ANTHROPIC_API_KEY=your_key_here
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_r2_access_key_id_here
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here
WEBHOOK_ENC_KEY=your_base64_32_byte_key_here
# Dashboard origin(s) allowed by CORS (comma-separated) and used for invite links
CORS_ORIGINS=YOUR_DASHBOARD_ORIGIN_HERE
DASHBOARD_URL=YOUR_DASHBOARD_URL_HERE
